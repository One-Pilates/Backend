# =========================
# Servidor
# =========================
SERVER_PORT=8080

# =========================
# Banco de dados MySQL
# =========================
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=sua_senha

# =========================
# JPA / Hibernate
# =========================
JPA_SHOW_SQL=true
JPA_DDL_AUTO=update
TIMEZONE=America/Sao_Paulo

# =========================
# JWT
# =========================
JWT_SECRET=seu_secret_aqui_minimo_32_caracteres
JWT_EXPIRATION=86400000

# =========================
# RabbitMQ
# =========================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
EMAIL_QUEUE=email.queue
EMAIL_EXCHANGE=email.exchange
EMAIL_ROUTING_KEY=email.routingkey

# =========================
# Upload de arquivos
# =========================
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# =========================
# Administrador inicial
# =========================
USER_ADMIN_EMAIL=admin@onepilates.com
USER_ADMIN_NOME=Administrador
USER_ADMIN_CPF=00000000000

# =========================
# IA (Groq)
# =========================
GROQ_API_KEY=sua_groq_api_key

